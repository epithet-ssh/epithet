#!/bin/sh

set -eu

usage() {
	echo "usage: epithet-pkg-test CANDIDATE_REPOSITORY VERSION [PREVIOUS_PACKAGE]" >&2
	exit 64
}

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage

repository=$(realpath "$1")
version=$2
binary_version=${version%%_*}
previous_package=${3:-}
public_key=${EPITHET_PKG_PUBLIC_KEY:?EPITHET_PKG_PUBLIC_KEY is required}

work=$(mktemp -d /var/tmp/epithet-pkg-test.XXXXXX)
trap 'rm -rf "$work"' EXIT INT TERM HUP

repos_dir="$work/repos"
root="$work/root"
mkdir -p "$repos_dir"

cat > "$repos_dir/Epithet.conf" <<EOF
Epithet: {
    url: "file://${repository}",
    signature_type: "pubkey",
    pubkey: "${public_key}",
    enabled: yes
}
EOF

pkg_cmd() {
	pkg -r "$root" -o REPOS_DIR="$repos_dir" "$@"
}

reset_root() {
	rm -rf "$root"
	mkdir -p "$root/etc"
	cp /etc/master.passwd /etc/group "$root/etc/"
	pwd_mkdb -d "$root/etc" "$root/etc/master.passwd"
}

assert_version() {
	package_version=$(pkg_cmd query '%v' epithet)
	[ "$package_version" = "$version" ] || {
		echo "pkg installed unexpected version: $package_version" >&2
		exit 1
	}
	actual=$($root/usr/local/bin/epithet --version)
	case "$actual" in
	*"$binary_version"*) ;;
	*)
		echo "installed binary reported unexpected version: $actual" >&2
		exit 1
		;;
	esac
}

assert_service_files() {
	grep -q '^epithet:' "$root/etc/master.passwd" || {
		echo "package did not create the epithet service account" >&2
		exit 1
	}
	[ -f "$root/usr/local/etc/epithet/server.yaml.sample" ] || {
		echo "package did not install the shared configuration sample" >&2
		exit 1
	}
	[ -f "$root/usr/local/etc/epithet/server.yaml" ] || {
		echo "package did not install the shared default configuration" >&2
		exit 1
	}
	for service in epithet_server epithet_ca epithet_policy; do
		script="$root/usr/local/etc/rc.d/$service"
		[ -x "$script" ] || {
			echo "package did not install executable rc.d service $service" >&2
			exit 1
		}
		grep -Fq ": \${${service}_enable:=NO}" "$script" || {
			echo "$service is not disabled by default" >&2
			exit 1
		}
		grep -Fq ": \${${service}_config:=/usr/local/etc/epithet/server.yaml}" "$script" || {
			echo "$service does not use the shared default configuration" >&2
			exit 1
		}
		grep -Fq ": \${${service}_runas:=epithet}" "$script" || {
			echo "$service does not configure daemon's runtime user" >&2
			exit 1
		}
		if grep -Fq ": \${${service}_user:=" "$script"; then
			echo "$service uses rc.subr's reserved user variable and would drop privileges twice" >&2
			exit 1
		fi
	done
}

reset_root
pkg_cmd update -f
pkg_cmd install -y -r Epithet epithet
assert_version
assert_service_files
$root/usr/local/bin/epithet host enroll --help >/dev/null
pkg_cmd delete -y epithet
[ ! -e "$root/usr/local/bin/epithet" ]
[ ! -e "$root/usr/local/etc/epithet/server.yaml" ]

if [ -n "$previous_package" ]; then
	previous_package=$(realpath "$previous_package")
	reset_root
	pkg_cmd add "$previous_package"

	mkdir -p "$root/var/db/epithet" "$root/etc/ssh/sshd_config.d"
	printf '%s\n' 'epithet-host-v1-AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8' > "$root/var/db/epithet/host-id"
	printf '%s\n' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIG9ubHktYS1wYWNrYWdlLXRlc3Q epithet-test' > "$root/var/db/epithet/epithet-ca.pub"
	printf '%s\n' '# managed enrollment fixture' > "$root/etc/ssh/sshd_config.d/60-epithet.conf"
	mkdir -p "$root/usr/local/etc/epithet"
	printf '%s\n' '# operator-managed service configuration' > "$root/usr/local/etc/epithet/server.yaml"

	before=$(find "$root/var/db/epithet" "$root/etc/ssh/sshd_config.d/60-epithet.conf" "$root/usr/local/etc/epithet/server.yaml" -type f -exec sha256 -q {} \; | sha256 -q)
	pkg_cmd upgrade -y -r Epithet epithet
	assert_version
	assert_service_files
	after=$(find "$root/var/db/epithet" "$root/etc/ssh/sshd_config.d/60-epithet.conf" "$root/usr/local/etc/epithet/server.yaml" -type f -exec sha256 -q {} \; | sha256 -q)
	[ "$before" = "$after" ] || {
		echo "package upgrade changed enrolled host state or service configuration" >&2
		exit 1
	}

	pkg_cmd delete -y epithet
	after_delete=$(find "$root/var/db/epithet" "$root/etc/ssh/sshd_config.d/60-epithet.conf" "$root/usr/local/etc/epithet/server.yaml" -type f -exec sha256 -q {} \; | sha256 -q)
	[ "$before" = "$after_delete" ] || {
		echo "package deletion changed enrolled host state or service configuration" >&2
		exit 1
	}
fi
