#!/bin/sh

set -eu

CONFIG=${EPITHET_PKG_CONFIG:-/usr/local/etc/epithet-pkg.conf}
[ -r "$CONFIG" ] || {
	echo "cannot read configuration: $CONFIG" >&2
	exit 1
}
. "$CONFIG"

: "${POUDRIERE_JAIL:?}"
: "${POUDRIERE_PORTS:?}"
: "${PORT_ORIGIN:?}"
: "${PORT_TEMPLATE:?}"
: "${PORT_DIR:?}"
: "${POUDRIERE_PACKAGES:?}"
: "${POUDRIERE_PACKAGE_BRANCH:?}"
: "${SOURCE_REPOSITORY:?}"
: "${PUBLIC_ROOT:?}"
: "${SIGNING_KEY:?}"
: "${REPOSITORY_URL:?}"

ABI=FreeBSD:15:amd64
ABI_ROOT=$PUBLIC_ROOT/$ABI
LOCK_FILE=/var/run/epithet-pkg-publish.lock

usage() {
	cat >&2 <<EOF
usage: epithet-pkg-publish publish vX.Y.Z[_N]
       epithet-pkg-publish status
       epithet-pkg-publish rollback X.Y.Z[_N]
EOF
	exit 64
}

require_root() {
	[ "$(id -u)" -eq 0 ] || {
		echo "epithet-pkg-publish must run as root" >&2
		exit 1
	}
}

current_version() {
	if [ -L "$ABI_ROOT/latest" ]; then
		basename "$(readlink "$ABI_ROOT/latest")"
	else
		echo none
	fi
}

validate_source_version() {
	if ! printf '%s\n' "$1" | awk '/^[0-9]+\.[0-9]+\.[0-9]+$/ { valid = 1 } END { exit !valid }'; then
		echo "invalid source version: $1" >&2
		exit 64
	fi
}

parse_release_spec() {
	prs_spec=$1
	case "$prs_spec" in
	v*) prs_package_version=${prs_spec#v} ;;
	*) echo "release must be an explicit vX.Y.Z or vX.Y.Z_N version" >&2; exit 64 ;;
	esac

	case "$prs_package_version" in
	*_*)
		prs_source_version=${prs_package_version%%_*}
		prs_revision=${prs_package_version#*_}
		case "$prs_revision" in
		''|0|0[0-9]*|*[!0-9]*) echo "invalid package revision: $prs_revision" >&2; exit 64 ;;
		esac
		case "$prs_revision" in
		*_* ) echo "invalid release version: $prs_package_version" >&2; exit 64 ;;
		esac
		;;
	*)
		prs_source_version=$prs_package_version
		prs_revision=0
		;;
	esac
	validate_source_version "$prs_source_version"

	RELEASE_SOURCE_VERSION=$prs_source_version
	RELEASE_PORTREVISION=$prs_revision
	RELEASE_PACKAGE_VERSION=$prs_package_version
	RELEASE_SOURCE_TAG=v$prs_source_version
}

render_port() {
	rp_source_version=$1
	rp_revision=$2
	rm -rf "$PORT_DIR"
	mkdir -p "$PORT_DIR"
	cp -R "$PORT_TEMPLATE"/. "$PORT_DIR"/
	sed \
		-e "s/^DISTVERSION=.*/DISTVERSION=\t${rp_source_version}/" \
		-e "s/^PORTREVISION=.*/PORTREVISION=\t${rp_revision}/" \
		"$PORT_DIR/Makefile" > "$PORT_DIR/Makefile.new"
	mv "$PORT_DIR/Makefile.new" "$PORT_DIR/Makefile"
	make -C "$PORT_DIR" BATCH=yes clean makesum
}

build_package() {
	bp_source_version=$1
	bp_revision=$2
	bp_package_version=$3
	render_port "$bp_source_version" "$bp_revision"
	poudriere testport -b "$POUDRIERE_PACKAGE_BRANCH" -j "$POUDRIERE_JAIL" -p "$POUDRIERE_PORTS" -o "$PORT_ORIGIN"
	poudriere bulk -b "$POUDRIERE_PACKAGE_BRANCH" -j "$POUDRIERE_JAIL" -p "$POUDRIERE_PORTS" "$PORT_ORIGIN"

	BUILT_PACKAGE=$(find -L "$POUDRIERE_PACKAGES/All" -maxdepth 1 -type f -name "epithet-${bp_package_version}.pkg" | head -n 1)
	[ -n "$BUILT_PACKAGE" ] || {
		echo "poudriere did not produce epithet ${bp_package_version}" >&2
		exit 1
	}
}

previous_version() {
	pv_tag=$1
	git -C "$SOURCE_REPOSITORY" tag --merged "${pv_tag}^" --sort=-version:refname |
		awk '/^v[0-9]+\.[0-9]+\.[0-9]+$/ { sub(/^v/, ""); print; exit }'
}

publish() {
	pub_spec=${1:-}
	parse_release_spec "$pub_spec"
	pub_source_version=$RELEASE_SOURCE_VERSION
	pub_revision=$RELEASE_PORTREVISION
	pub_package_version=$RELEASE_PACKAGE_VERSION
	pub_source_tag=$RELEASE_SOURCE_TAG

	if [ "$(current_version)" = "$pub_package_version" ]; then
		echo "epithet ${pub_package_version} is already published"
		return
	fi
	[ ! -e "$ABI_ROOT/releases/$pub_package_version" ] || {
		echo "release ${pub_package_version} already exists; use rollback to select an existing release" >&2
		exit 1
	}

	if [ ! -d "$SOURCE_REPOSITORY/.git" ]; then
		mkdir -p "$(dirname "$SOURCE_REPOSITORY")"
		git clone https://github.com/epithet-ssh/epithet "$SOURCE_REPOSITORY"
	fi
	git -C "$SOURCE_REPOSITORY" fetch --force --tags origin
	git -C "$SOURCE_REPOSITORY" rev-parse --verify "${pub_source_tag}^{commit}" >/dev/null

	work=$(mktemp -d /var/tmp/epithet-pkg-publish.XXXXXX)
	trap 'rm -rf "$work"' EXIT INT TERM HUP

	previous_package=
	pub_current_version=$(current_version)
	if [ "$pub_current_version" != none ]; then
		pub_current_package=$(find -L "$ABI_ROOT/latest/All" -maxdepth 1 -type f -name "epithet-${pub_current_version}.pkg" | head -n 1)
		[ -n "$pub_current_package" ] || {
			echo "published repository does not contain epithet ${pub_current_version}" >&2
			exit 1
		}
		previous_package=$work/$(basename "$pub_current_package")
		cp "$pub_current_package" "$previous_package"
	else
		previous=$(previous_version "$pub_source_tag")
		if [ -n "$previous" ]; then
			build_package "$previous" 0 "$previous"
			previous_package=$work/$(basename "$BUILT_PACKAGE")
			cp "$BUILT_PACKAGE" "$previous_package"
		fi
	fi

	build_package "$pub_source_version" "$pub_revision" "$pub_package_version"
	current_built=$BUILT_PACKAGE
	candidate=$work/repository
	mkdir -p "$candidate/All"
	cp "$current_built" "$candidate/All/"
	pkg repo "$candidate" "$SIGNING_KEY"

	public_key=$work/epithet.pub
	openssl rsa -in "$SIGNING_KEY" -pubout -out "$public_key"
	EPITHET_PKG_PUBLIC_KEY=$public_key /usr/local/sbin/epithet-pkg-test \
		"$candidate" "$pub_package_version" ${previous_package:+"$previous_package"}

	mkdir -p "$ABI_ROOT/releases" "$PUBLIC_ROOT/keys"
	mv "$candidate" "$ABI_ROOT/releases/$pub_package_version"
	install -m 0444 "$public_key" "$PUBLIC_ROOT/keys/epithet.pub"
	ln -s "releases/$pub_package_version" "$ABI_ROOT/.latest.$$"
	mv -fh "$ABI_ROOT/.latest.$$" "$ABI_ROOT/latest"
	printf '%s\n' "$pub_package_version" > "$ABI_ROOT/published-version"
	printf 'published epithet %s at %s/%s/latest\n' "$pub_package_version" "$REPOSITORY_URL" "$ABI"
}

rollback() {
	parse_release_spec "v${1:-}"
	rollback_version=$RELEASE_PACKAGE_VERSION
	[ -d "$ABI_ROOT/releases/$rollback_version" ] || {
		echo "release ${rollback_version} is not retained" >&2
		exit 1
	}
	ln -s "releases/$rollback_version" "$ABI_ROOT/.latest.$$"
	mv -fh "$ABI_ROOT/.latest.$$" "$ABI_ROOT/latest"
	printf '%s\n' "$rollback_version" > "$ABI_ROOT/published-version"
	echo "rolled back repository metadata to epithet ${rollback_version}"
}

require_root
command=${1:-}
case "$command" in
status)
	printf 'published: %s\n' "$(current_version)"
	;;
publish|rollback)
	shift
	[ "$#" -eq 1 ] || usage
	if [ "${EPITHET_PKG_LOCKED:-}" != 1 ]; then
		exec env EPITHET_PKG_LOCKED=1 lockf -k -t 0 "$LOCK_FILE" "$0" "$command" "$1"
	fi
	"$command" "$1"
	;;
*) usage ;;
esac
