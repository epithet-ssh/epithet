# Installed as /usr/local/etc/epithet-pkg.conf on the repository host.
POUDRIERE_JAIL=151amd64
POUDRIERE_PORTS=epithet
PORT_ORIGIN=security/epithet
PORT_TEMPLATE=/usr/local/share/epithet-pkg/port
PORT_DIR=/usr/local/poudriere/ports/epithet/security/epithet
