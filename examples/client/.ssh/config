SetEnv TERM=xterm-256color

# Tag the hosts epithet should handle. The generated config below is gated
# on `Match tagged epithet`, so hosts without a Tag never reach epithet.
Host *.example.com
    Tag epithet

# Must come *after* the Tag lines above: ssh evaluates the file top to
# bottom, and a Match tagged block can only see tags already set.
Include ~/.epithet/run/*/ssh-config.conf
