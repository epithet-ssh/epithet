# Example epithet configuration file
#
# Location: ~/.epithet/*.yaml (or .yml, .json)
#
# Format: YAML (also supports JSON)
# Config sections mirror the CLI command structure.
# Use kebab-case for keys to match CLI flag names.

# Global flags (apply to all commands)
# insecure: true           # Disable TLS verification (NOT RECOMMENDED)
# verbose: 1               # Log level (1=info, 2=debug)
# log-file: /var/log/epithet.log
# tls-ca-cert: /path/to/ca.crt

# Agent configuration (epithet agent)
# OIDC issuer/client-id are discovered from the CA URL via its Link header.
# Nothing to configure here. Host gating lives in your own ~/.ssh/config via
# Tag/Include, not in this file.
agent:
  ca-url: https://ca.example.com
  name: default   # profile name; determines the rundir and ssh Tag (epithet-<name>; just "epithet" for the default profile)

# CA server configuration (epithet ca)
# ca:
#   policy: https://policy.example.com
#   inventory: https://inventory.example.com
#   key: /etc/epithet/ca.key
#   listen: "0.0.0.0:8080"

# Policy server configuration (epithet policy)
# All policy config is unified here - no separate policy.yaml needed
# policy:
#   listen: "0.0.0.0:9999"
#   ca-pubkey: ssh-ed25519 AAAAC3...  # or URL like https://ca.example.com/pubkey
#   default-expiration: "5m"
#
#   policy-file: /etc/epithet/policy.writ
#
# Inventory service configuration (epithet inventory)
# inventory:
#   # OIDC configuration for token validation - client-id is required so
#   # audience checking can never be silently skipped. Config-file keys
#   # here are kebab-case (derived from the CLI flag names).
#   oidc:
#     issuer: "https://accounts.google.com"
#     client-id: "your-client-id"
#
#   ca-pubkey: /etc/epithet/ca.pub
#   static: [/etc/epithet/inventory.yaml]
#   principal-mode: account-name
#
# Note: Broker socket and agent directories are automatically managed
# in ~/.epithet/run/<name>/ - no configuration needed!
