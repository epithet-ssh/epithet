# Flat TOML: copy to ~/.epithet/config.toml.
# Keys are exact long flag names; there are no command sections.
# Use arrays for list-valued flags, including a single item.
# Precedence: CLI > config > environment > built-in default.

ca = ["https://ca.example.com"]
agent-name = "default"
login-method = "auto"

# Global settings:
# verbose = 1 # 1 = info, 2 = debug
# log-file = "/var/log/epithet.log"
# tls-ca-cert-file = "/path/to/ca.crt"

# OIDC settings are discovered by the agent from the CA.
# Host selection belongs in ~/.ssh/config through Tag/Include.
# For server settings, see inventory-scim.example.toml and docs/inventory.md.
# Separately deployed services can use separate files for differing values.
